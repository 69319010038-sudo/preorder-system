<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="PreOrder.App.MainPage" Title="สั่งอาหารล่วงหน้า">
  <ScrollView>
    <VerticalStackLayout Padding="16" Spacing="10">
      <Label x:Name="RoundLabel" FontAttributes="Bold" FontSize="18"/>
      <Label x:Name="TimeLabel" FontSize="12"/>

      <Entry x:Name="NameEntry" Placeholder="ชื่อผู้สั่ง"/>

      <CollectionView x:Name="MenuList" SelectionMode="None">
        <CollectionView.ItemTemplate>
          <DataTemplate>
            <Grid ColumnDefinitions="*,Auto,Auto" Padding="0,4" ColumnSpacing="10">
              <Label Text="{Binding Name}" VerticalOptions="Center"/>
              <Label Grid.Column="1" Text="{Binding PriceText}" VerticalOptions="Center"/>
              <Stepper Grid.Column="2" Minimum="0" Maximum="99" Increment="1" Value="{Binding Qty, Mode=TwoWay}"/>
            </Grid>
          </DataTemplate>
        </CollectionView.ItemTemplate>
      </CollectionView>

      <Label x:Name="TotalLabel" FontAttributes="Bold"/>
      <Button x:Name="SubmitBtn" Text="ยืนยันสั่ง" Clicked="OnSubmit"/>

      <BoxView HeightRequest="1" Color="Gray"/>
      <Label Text="แก้ไข/ยกเลิก ด้วยรหัสคำสั่งซื้อ"/>
      <Entry x:Name="CodeEntry" Placeholder="รหัสคำสั่งซื้อ" Keyboard="Plain"/>
      <HorizontalStackLayout Spacing="8">
        <Button Text="โหลด" Clicked="OnLoad"/>
        <Button x:Name="SaveBtn" Text="บันทึกแก้ไข" Clicked="OnSave"/>
        <Button x:Name="CancelBtn" Text="ยกเลิกออเดอร์" Clicked="OnCancel"/>
      </HorizontalStackLayout>
      <Label x:Name="StatusLabel"/>
    </VerticalStackLayout>
  </ScrollView>
</ContentPage>
